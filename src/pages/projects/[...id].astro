---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Architecture from '../../components/Architecture.astro';
import { site } from '../../config/site';
import { localUrl } from '../../lib/urls';
export async function getStaticPaths() {
  return (await getCollection('projects', ({ data }) => !data.draft)).map(
    (project) => ({ params: { id: project.id }, props: { project } }),
  );
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const [preview, ...additional] = data.screenshots;
---

<Layout
  title={data.title + ' | ' + site.name}
  description={data.shortDescription}
  project={data}
>
  <div class="container">
    <header class="project-header">
      <a class="quiet-link" href={localUrl('/projects/')}>
        ← All pipelines
      </a>
      <p class="project-category">{data.category}</p>
      <div class="project-title-row">
        <div>
          <h1>{data.title}</h1>
          <p>{data.shortDescription}</p>
        </div>
        <div class="project-header-actions">
          {data.downloads.map((download) => (
            <a class="button primary" href={localUrl(download.path)} download>
              {download.label} ↓
            </a>
          ))}
          {data.reportUrl && (
            <a class="button secondary" href={localUrl(data.reportUrl)}>
              View report →
            </a>
          )}
          {data.githubUrl && (
            <a class="button secondary" href={data.githubUrl}>
              GitHub ↗
            </a>
          )}
          {data.liveDemoUrl && (
            <a class="button secondary" href={data.liveDemoUrl}>
              Live demo ↗
            </a>
          )}
        </div>
      </div>
      {data.downloads.length > 0 && (
        <p class="download-note">
          {data.downloads.map((item) => item.size).join(' · ')} · Open in Power
          BI Desktop to use the report.
        </p>
      )}
    </header>
    <section
      class="pipeline-overview"
      aria-labelledby="pipeline-overview-heading"
    >
      <h2 id="pipeline-overview-heading">From source to report</h2>
      <Architecture steps={data.architecture} compact />
      {data.architectureNote && (
        <p class="pipeline-handoff">{data.architectureNote}</p>
      )}
    </section>
    <div class="project-summary">
      <section>
        <h2>The business problem</h2>
        <p>{data.problem}</p>
        <h2 class="contribution-heading">My contribution</h2>
        <p>{data.fullDescription}</p>
        {data.keyFeatures.length > 0 && (
          <ul class="feature-list">
            {data.keyFeatures.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        )}
      </section>
      <aside>
        <h2>Tools</h2>
        <ul class="tags">
          {data.technologies.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
        {data.githubUrl && (
          <a class="text-link source-link" href={data.githubUrl}>
            Source code & setup ↗
          </a>
        )}
      </aside>
    </div>
    {data.designDecisions.length > 0 && (
      <section
        class="pipeline-decisions"
        aria-labelledby="pipeline-decisions-heading"
      >
        <h2 id="pipeline-decisions-heading">Why I built it this way</h2>
        <div class="decision-grid">
          {data.designDecisions.map((decision) => (
            <article>
              <h3>{decision.title}</h3>
              <p>{decision.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}
    {preview && (
      <div class="reporting-outcome">
        <h2 class="reporting-outcome-heading">The reporting outcome</h2>
        {data.reportingOutcome && <p>{data.reportingOutcome}</p>}
      </div>
    )}
    {preview ? (
      <figure class="main-preview">
        <a
          href={localUrl(preview.src)}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={'Open full-size preview: ' + preview.alt}
        >
          <img
            src={localUrl(preview.src)}
            alt={preview.alt}
            width={preview.width}
            height={preview.height}
            fetchpriority="high"
          />
        </a>
        <figcaption>
          <span>{preview.caption || 'Project preview'}</span>
          <a
            href={localUrl(preview.src)}
            target="_blank"
            rel="noopener noreferrer"
          >
            View full size ↗
          </a>
        </figcaption>
      </figure>
    ) : (
      data.architecture.length > 0 && (
        <section class="architecture-preview" aria-label="Project workflow">
          <Architecture steps={data.architecture} />
        </section>
      )
    )}
    {additional.length > 0 && (
      <details class="additional-previews">
        <summary>
          More screenshots <span>({additional.length})</span>
        </summary>
        {additional.map((screenshot) => (
          <figure>
            <a
              href={localUrl(screenshot.src)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={localUrl(screenshot.src)}
                alt={screenshot.alt}
                width={screenshot.width}
                height={screenshot.height}
                loading="lazy"
              />
            </a>
            <figcaption>{screenshot.caption}</figcaption>
          </figure>
        ))}
      </details>
    )}
    <details class="technical-details">
      <summary>Implementation details</summary>
      <div class="prose">
        <Content />
      </div>
    </details>
    <div class="project-bottom">
      <a class="text-link" href={localUrl('/projects/')}>
        ← All pipelines
      </a>
      <a class="text-link" href={'mailto:' + site.email}>
        Contact {site.name.split(' ')[0]} ↗
      </a>
    </div>
  </div>
</Layout>

<style>
  .pipeline-overview {
    padding: 24px;
    background: #edf1f6;
    border: 1px solid var(--line);
    border-radius: 5px;
  }
  .pipeline-overview h2 {
    font-size: 1.03rem;
    margin-bottom: 16px;
  }
  .pipeline-handoff {
    font-size: 0.78rem;
    line-height: 1.7;
    margin-top: 14px;
  }
  .project-summary .contribution-heading {
    margin-top: 24px;
  }
  .pipeline-decisions {
    margin-bottom: 32px;
  }
  .pipeline-decisions > h2,
  .reporting-outcome-heading {
    font-size: 1.05rem;
    margin-bottom: 16px;
  }
  .decision-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .decision-grid article {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--surface);
  }
  .decision-grid h3 {
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .decision-grid p {
    margin-top: 10px;
    font-size: 0.82rem;
    line-height: 1.8;
  }
  .reporting-outcome > p {
    max-width: 800px;
    font-size: 0.86rem;
    line-height: 1.85;
    margin-bottom: 20px;
  }
  @media (max-width: 768px) {
    .decision-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .pipeline-overview {
      padding: 16px;
    }
  }
</style>
