---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { site } from '../config/site';
import { localUrl } from '../lib/urls';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  project?: { title: string; githubUrl?: string };
}
const {
  title = `${site.name} | Data Engineering & Business Intelligence`,
  description = site.description,
  noindex = false,
  project,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(localUrl('/'), Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': project ? 'SoftwareSourceCode' : 'Person',
  ...(project
    ? {
        name: project.title,
        url: canonical.href,
        codeRepository: project.githubUrl,
        author: { '@type': 'Person', name: site.name, url: home },
      }
    : {
        name: site.name,
        jobTitle: site.title,
        image: new URL(localUrl(site.profilePhoto), Astro.site).href,
        url: home,
        sameAs: [site.githubUrl, site.linkedinUrl],
        address: {
          '@type': 'PostalAddress',
          addressLocality: site.addressLocality,
          addressCountry: site.addressCountry,
        },
        knowsAbout: [
          'Data Engineering',
          'Power BI',
          'Microsoft Fabric',
          'Business Intelligence',
        ],
      }),
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={localUrl('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta
      property="og:image"
      content={new URL(localUrl('/images/social-card.png'), Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name} — Data Engineering & Business Intelligence`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={localUrl('/sitemap-index.xml')} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\u003c')}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={localUrl('/')} aria-label={`${site.name} home`}>
          <span class="brand-mark">
            {site.initials}
            <span>.</span>
          </span>
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main navigation">
          {site.navigation.map((item) => (
            <a href={localUrl(item.href)}>{item.label}</a>
          ))}
          <a class="nav-contact" href={localUrl('/#contact')}>
            Contact <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="container site-footer">
      <a class="brand" href={localUrl('/')}>
        <span class="brand-mark">
          {site.initials}
          <span>.</span>
        </span>
        <span>{site.name}</span>
      </a>
      <span>
        © {new Date().getFullYear()} · {site.location}
      </span>
    </footer>
  </body>
</html>
