---
import type { CollectionEntry } from 'astro:content';
import { localUrl } from '../lib/urls';
import Architecture from './Architecture.astro';
interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}
const { project } = Astro.props;
const { data } = project;
const preview = data.screenshots[0];
---

<article class:list={['project-card', { 'has-preview': data.thumbnail }]}>
  {data.thumbnail && (
    <a
      class="project-visual"
      href={localUrl('/projects/' + project.id + '/')}
      aria-label={'View ' + data.title}
      tabindex="-1"
    >
      <img
        src={localUrl(data.thumbnail)}
        alt={data.thumbnailAlt || ''}
        width={preview?.width || 1426}
        height={preview?.height || 798}
        loading="lazy"
      />
    </a>
  )}
  <div class="project-content">
    <p class="project-category">{data.category}</p>
    <h3>
      <a href={localUrl('/projects/' + project.id + '/')}>{data.title}</a>
    </h3>
    <p class="project-description">{data.shortDescription}</p>
    <ul class="pipeline-highlights" aria-label="Project highlights">
      {data.keyFeatures.slice(0, 3).map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
    <ul class="tags" aria-label="Technologies">
      {data.technologies.slice(0, 4).map((tech) => (
        <li>{tech}</li>
      ))}
    </ul>
    <div class="project-actions">
      {data.downloads[0] && (
        <a
          class="button primary"
          href={localUrl(data.downloads[0].path)}
          download
        >
          Download PBIX <span aria-hidden="true">↓</span>
        </a>
      )}
      <a class="text-link" href={localUrl('/projects/' + project.id + '/')}>
        View pipeline <span aria-hidden="true">→</span>
      </a>
      {data.githubUrl && (
        <a
          class="quiet-link"
          href={data.githubUrl}
          aria-label={data.title + ' source code on GitHub'}
        >
          GitHub ↗
        </a>
      )}
    </div>
    {data.downloads[0] && (
      <p class="download-note">
        {data.downloads[0].size} · Opens in Power BI Desktop
      </p>
    )}
  </div>
  {data.architecture.length > 0 && (
    <div class="pipeline-card-flow">
      <Architecture steps={data.architecture} compact />
    </div>
  )}
</article>

<style>
  .pipeline-highlights {
    list-style: disc;
    padding-left: 16px;
    margin-top: 14px;
  }
  .pipeline-highlights li {
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.75;
    padding-bottom: 4px;
  }
  .pipeline-card-flow {
    grid-column: 1 / -1;
    border-top: 1px solid var(--line);
    padding: 16px 24px;
    background: #f7f9fc;
  }
  @media (max-width: 560px) {
    .pipeline-card-flow {
      padding: 14px;
    }
  }
</style>
